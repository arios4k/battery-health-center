#: src/ui/health.rs:189
#, no-c-format
msgid ""
"Your laptop will charge to 100%. Then unplug it and use it normally until "
"the battery reaches {CALIBRATION_EMPTY}%, and charge it to 100% again. "
"You'll get a notification at each step, and your charge limit comes back at "
"the end."
msgstr ""
"Tu portátil se cargará al 100 %. Después, desconéctalo y úsalo con "
"normalidad hasta que la batería llegue al {CALIBRATION_EMPTY} %, y vuelve a "
"cargarlo al 100 %. Recibirás una notificación en cada paso y tu límite de "
"carga vuelve al final."

#: src/ui/health.rs:209
msgid "You'll get a notification at each step."
msgstr "Recibirás una notificación en cada paso."

