#, no-c-format
msgid "{0} Is Using Significant Energy"
msgstr "{0} consomme beaucoup d’énergie"

#: src/controller.rs:571
msgid "Quit it if you're not using it to make your battery last longer."
msgstr ""
"Quittez-la si vous ne l’utilisez pas pour prolonger l’autonomie de la "
"batterie."

#: src/controller.rs:585
msgid "High Battery Drain During Sleep"
msgstr "Forte décharge pendant la veille"

#: src/controller.rs:586
#, no-c-format
