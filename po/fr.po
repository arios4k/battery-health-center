msgstr "Prochaine charge ignorée"

#: src/ui/charging.rs:372
msgid "Back to your charge limit"
msgstr "Retour à votre limite de charge"

#: src/ui/charging.rs:375
msgid "Charging to 100% once; your limit comes back when full or unplugged"
msgstr ""
"Charge à 100% une seule fois ; votre limite revient quand la batterie est "
"pleine ou débranchée"

#: src/ui/charging.rs:38
