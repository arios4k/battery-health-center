msgstr "En charge, actuellement à {pct}%"

#: src/ui/health.rs:227
msgid "Connect the charger to continue"
msgstr "Branchez le chargeur pour continuer"

#: src/ui/health.rs:228
#, no-c-format
msgid "Step {n} of 3: Charge to 100%"
msgstr "Étape {n} sur 3 : charger à 100%"

#: src/ui/health.rs:232
msgid "Unplug the charger to continue"
msgstr "Débranchez le chargeur pour continuer"

