#: src/ui/charging.rs:142
msgid "Next Scheduled Full Charge"
msgstr "Prochaine charge complète programmée"

#: src/ui/charging.rs:143
msgid "Temporary Override"
msgstr "Dérogation temporaire"

#: src/ui/charging.rs:15
msgid "Pause Charging"
