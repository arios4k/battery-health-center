msgstr "Durée de vie maximale (60%)"

#: src/ui/charging.rs:30
msgid "Balanced (80%)"
msgstr "Équilibré (80%)"

#: src/ui/charging.rs:31
msgid "Full Capacity (100%)"
msgstr "Pleine capacité (100%)"

#: src/ui/charging.rs:32
msgid "Custom"
msgstr "Personnalisé"

#: src/ui/charging.rs:334
msgid "One-off charging plan cancelled"
msgstr "Plan de charge ponctuel annulé"

#: src/ui/charging.rs:341
